{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local baseline observation, not a cloud evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "verification", "scenario", "source_revision", "started_at", "finished_at", "result", "requested_jobs", "completed_jobs", "completion_seconds", "fixture_sha256", "golden_reports_match", "telemetry", "errors", "cloud_provisioned", "teardown"],
  "properties": {
    "schema_version": {"const": "local-baseline-v1"},
    "run_id": {"type": "string", "pattern": "^local-[0-9a-f]{32}$"},
    "verification": {"const": "local-compose"},
    "scenario": {"const": "baseline-smoke"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["passed", "failed"]},
    "requested_jobs": {"type": "integer", "minimum": 1, "maximum": 100},
    "completed_jobs": {"type": "integer", "minimum": 0, "maximum": 100},
    "completion_seconds": {"type": "array", "maxItems": 100, "items": {"type": "number", "minimum": 0, "maximum": 60}},
    "fixture_sha256": {"const": "2522de9d1c28cf3a163c3703dbabb2b63009e5daa6a8d98f2aac85f577307bd5"},
    "golden_reports_match": {"type": "boolean"},
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["api_metrics", "worker_metrics", "prometheus_targets"],
      "properties": {
        "api_metrics": {"type": "boolean"},
        "worker_metrics": {"type": "boolean"},
        "prometheus_targets": {"type": "boolean"}
      }
    },
    "errors": {"type": "array", "maxItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z]{1,64}$"}},
    "cloud_provisioned": {"const": false},
    "teardown": {"const": "not_checked"}
  }
}
